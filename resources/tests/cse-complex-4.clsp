(mod (X)
  (include *standard-cl-26*)

  (defun F (X Y)
    (+
      (if
        (assign
          A (+ (l (@ Y 1)) 1)
          B (+ (l (@ Y 1)) (+ A 1))
          C (+ (l (@ Y 1)) (+ A 1))
          D (if (l (@ Y 1)) (+ Y 2) ())
          (+ A (+ A 1) (+ A 1) (l (@ Y 1)) B C D)
        )
        (let
          ((C (+ Y 2))
           (D (+ Y 2))
           (E (+ Y 2))
           (F 2))
          (+ (+ Y 2) (+ Y 2) C D E F)
        )
        (let*
          ((E (+ X 3))
           (F (+ E 1))
           (G (+ (+ X 3) (+ E 1) F))
           (H (+ (+ X 3) (+ E 1) (+ (+ X 3) (+ E 1) F) G)))
          (+ (+ X 3) (+ E 1) G F H)
        )
      )
      (+
        (strlen
          (assign
            H "X"
            H
          )
        )
        (+
          (strlen
            (let
              ((I "X")
               (J (+ X 1)))
              I
            )
          )
          (strlen
            (let*
              ((K "Y")
               (L K))
              L
            )
          )
        )
      )
    )
  )

  (F X)
)
